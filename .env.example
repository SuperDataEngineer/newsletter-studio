# ── Database (RDS IAM auth — no static password) ─────────────────────────────
# Set at runtime via scripts/db-token.sh (generates a 15-min IAM token)
RDS_HOST=database-1.cluster-c2t6oaeuaoq9.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=postgres
RDS_USERNAME=newsletter_studio

# For drizzle-kit migrations only (generated by scripts/db-token.sh):
# DATABASE_URL=postgres://newsletter_studio:<iam-token>@<host>:5432/postgres?sslmode=require

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=newsletter-studio-exports
SQS_BRIEF_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/newsletter-brief-queue
SQS_DRAFT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/newsletter-draft-queue

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Research ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
EXA_API_KEY=
FIRECRAWL_API_KEY=fc-...

# ── Observability ─────────────────────────────────────────────────────────────
HELICONE_API_KEY=

